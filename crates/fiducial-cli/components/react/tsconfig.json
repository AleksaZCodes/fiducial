{
  // This directory is both the registry source and its own package, so the
  // files that ship are the files that get typechecked — in place, with their
  // own node_modules.
  //
  // It used to be typechecked from a second, byte-identical copy under
  // `packages/ui-react/`, and the two had already drifted: the shipping copy
  // imported `cn` from `../lib/utils`, which does not resolve from the
  // `components/ui/` directory `fid add component` installs into, while the
  // copy that was checked imported `./lib/utils` and passed. A typecheck that
  // only ever ran against a file nobody ships is worse than none.
  //
  // `@/lib/utils` is the alias a product resolves through its own tsconfig. The
  // file it names ships in the web-next template, which is its one declaration
  // (`fid add component` embeds the same bytes), so it is mapped there. That
  // file sits outside this package's node_modules, so `clsx` and
  // `tailwind-merge` are mapped to the copies installed here — otherwise the
  // check would fail on resolution rather than on anything the file says.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/lib/utils": ["../../capabilities/web-next/apps/web/src/lib/utils.ts"],
      "clsx": ["./node_modules/clsx"],
      "tailwind-merge": ["./node_modules/tailwind-merge"],
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../capabilities/web-next/apps/web/src/lib/utils.ts"],
  "exclude": ["node_modules"]
}
