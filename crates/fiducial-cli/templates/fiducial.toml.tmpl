# fiducial.toml — product configuration
# Generated by `fid new {{name}}` (fiducial {{version}}).
# Edit product.name, product.version, and spine.enabled.
# Do not edit [guard] unless you know what you are changing.

[product]
name    = "{{name}}"
version = "0.1.0"

[spine]
# Set to true to use the L0 Rust crates (fiducial-core, fiducial-quantity, …).
# Leave false for pure-web products that need no shared Rust logic.
enabled = false

[capabilities]
# Installed capability identifiers added by `fid add`.
enabled = []

[advise]
# Advisory review (`fid advise`) is part of how this product is worked on: run
# before calling a change done, and as a non-blocking step on pull requests. It
# asks a model what no deterministic check can, needs a key (`fid advise key
# set`, or OPENROUTER_API_KEY in the environment and in CI), and never gates
# anything. Set false at any time to switch the asking off; nothing else reads it.
enabled = true

[guard]
# Active portable guard rules. Command names match only in command position —
# never inside quoted strings or as another command's argument (§11 of the
# design spec). Every name here must resolve to a rule that can actually fire;
# `fid doctor` reports one that does not.
rules = [
    "no-direct-main-push",
    "no-unpinned-cli-fetch",
]
