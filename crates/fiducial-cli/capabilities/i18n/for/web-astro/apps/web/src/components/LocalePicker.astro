---
import { flags } from "../generated/flags";
import { type Locale, locales, messages } from "../generated/messages";
import { queryLocaleHref } from "../lib/locale-href";
/**
 * The language picker: the Astro half of the platform's locale switcher.
 *
 * Its twins are `for/web-next/.../locale-picker.tsx` and
 * `for/web-svelte/.../LocalePicker.svelte`; every decision below is theirs,
 * restated. Read this list before changing any of them: each item is a bug that
 * shipped.
 *
 * **A list, not a toggle.** It used to be one link to "the other locale". That
 * works for exactly two languages and is silently wrong at three.
 *
 * **Every locale names itself.** A language is listed under its endonym
 * (`Srpski`, not `Serbian`), read from that locale's own catalog
 * (`locale.name`). A picker exists for someone who cannot read the page they are
 * looking at, so translating the list into the language they are trying to
 * leave is the one arrangement guaranteed to be useless. There is no table of
 * languages here and no branch on a locale code: dropping in `messages/de.json`
 * with a `locale` block adds German and nothing else has to be touched.
 *
 * **The flag is decoration and is marked as such.** A flag is a country and a
 * locale is a language; Serbian is not confined to Serbia. The flag is
 * `aria-hidden`, the endonym is the label. A region with no flag in the set
 * renders as no flag rather than as a broken image.
 *
 * **Real links.** Each row is an `<a href>`, so it is middle-clickable,
 * copyable and crawlable, with `hreflang` stating the relationship. A switcher
 * built from click handlers is invisible to a search engine and to anyone
 * opening it in a new tab.
 *
 * **A disclosure, not a menu.** This is navigation, and the right pattern for a
 * list of links that opens and closes is a disclosure (`<details>`), not
 * `role="menu"`, which promises arrow-key behaviour a list of links does not
 * have. The browser gives it keyboard operation, `aria-expanded` and focus
 * order for free; the script below adds only what `<details>` lacks: Escape and
 * a click outside close it. There is no framework runtime on a page that
 * otherwise sends none.
 */

interface Props {
  locale: Locale;
  variant?: "full" | "icon";
  /** The page the picker is on, so a language link can stay on the same page. */
  url: URL | string;
  /**
   * Where a language leads. Defaults to `?lang=`, which needs no routing. A
   * product with locale-prefixed routes passes its own builder.
   */
  href?: (target: Locale) => string;
}

const { locale, variant = "full", url, href = (target: Locale) => queryLocaleHref(url, target) } = Astro.props;

/**
 * Flags as plain SVG strings, one per declared region: `generated/flags.ts` is
 * derived from the catalogs' `locale.region`, so a new locale's flag needs no
 * edit here and only the declared ones are bundled.
 */
const flagFor = (l: Locale) => flags[messages[l]["locale.region"] as keyof typeof flags] as string | undefined;
---

<details class="fid-locale" data-fid-locale>
  <summary
    class="fid-locale-trigger"
    data-variant={variant}
    aria-label={messages[locale]["locale.switch"]}
    title={variant === "icon" ? messages[locale]["locale.name"] : undefined}
  >
    {flagFor(locale) && <span class="fid-flag" aria-hidden="true" set:html={flagFor(locale)} />}
    {
      variant === "full" && (
        <>
          <span>{messages[locale]["locale.name"]}</span>
          <svg viewBox="0 0 16 16" class="fid-chevron" aria-hidden="true">
            <path d="M4 6 L8 10 L12 6" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </>
      )
    }
  </summary>
  <ul class="fid-locale-menu">
    {
      locales.map((l) => (
        <li>
          <a class="fid-locale-item" href={href(l)} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined}>
            {flagFor(l) && <span class="fid-flag" aria-hidden="true" set:html={flagFor(l)} />}
            <span class="fid-locale-name">{messages[l]["locale.name"]}</span>
            {l === locale && (
              <svg viewBox="0 0 16 16" class="fid-check" aria-hidden="true">
                <path d="M3 8.5 L6.5 12 L13 4" fill="none" stroke="currentColor" stroke-width="1.75" />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // The two things `<details>` does not do: close on Escape, and close when
  // the reader clicks anywhere else. Escape returns focus to the trigger, so
  // a keyboard user is not stranded.
  const pickers = document.querySelectorAll<HTMLDetailsElement>("[data-fid-locale]");
  for (const d of pickers) {
    d.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && d.open) {
        d.open = false;
        d.querySelector("summary")?.focus();
      }
    });
  }
  document.addEventListener("click", (e) => {
    for (const d of pickers) if (d.open && !d.contains(e.target as Node)) d.open = false;
  });
</script>

<style>
  .fid-locale {
    position: relative;
    display: inline-block;
  }
  .fid-locale-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border, currentColor);
    border-radius: var(--radius-sm, 3px);
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    list-style: none;
  }
  .fid-locale-trigger::-webkit-details-marker {
    display: none;
  }
  .fid-locale-trigger[data-variant="icon"] {
    padding: 0.375rem;
  }
  .fid-flag {
    display: inline-flex;
    width: 1.3125rem;
    height: 0.875rem;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 1px;
  }
  .fid-flag :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .fid-chevron,
  .fid-check {
    width: 0.875rem;
    height: 0.875rem;
  }
  .fid-check {
    opacity: 0.6;
  }
  /* A radius token is the PRODUCT's decision and may be 999px: a pill design
     system. On a small control that is the intent; on a large surface the same
     token turns a card into a circle. So a large surface follows the product's
     scale only up to a cap, and small controls take it whole. */
  .fid-locale-menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 6px);
    min-width: 10rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    border: 1px solid var(--border, currentColor);
    border-radius: min(var(--radius-md, 6px), 12px);
    background: var(--popover, var(--background, #fff));
    color: var(--popover-foreground, var(--foreground, inherit));
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
    z-index: var(--z-overlay, 1000);
  }
  .fid-locale-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-sm, 3px);
    color: inherit;
    text-decoration: none;
  }
  .fid-locale-name {
    flex: 1;
  }
  .fid-locale-item:hover,
  .fid-locale-item:focus-visible {
    background: var(--accent, rgb(0 0 0 / 0.06));
    color: var(--accent-foreground, inherit);
  }
</style>
