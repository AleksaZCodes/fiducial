{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "files": {
    "ignore": [
      "**/.astro/**",
      "**/dist/**",
      "**/.wrangler/**",
      "**/node_modules/**",
      "**/generated/**",
      "**/app/tokens.css",
      "**/wrangler.jsonc",
      "**/public/**",
      "scripts/**",
      "tools/**",
      "apps/cms/**",
      "**/*.generated.ts",
      "registry.json",
      "design/**",
      ".fiducial/**",
      ".agents/**",
      ".claude/**"
    ]
  },
  "overrides": [
    {
      "include": ["*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
