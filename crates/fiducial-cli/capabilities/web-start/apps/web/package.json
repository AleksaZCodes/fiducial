    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
