{
  "name": "@fiducial/ui-svelte",
  "version": "0.1.0",
  "description": "Thin Svelte component layer built on @fiducial/tokens and @fiducial/headless.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./Button.svelte": "./src/Button.svelte",
    "./StatusBadge.svelte": "./src/StatusBadge.svelte"
  },
  "scripts": {
    "build":     "echo 'svelte components export from src directly'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "dependencies": {
    "@fiducial/tokens":   "workspace:*",
    "@fiducial/headless": "workspace:*"
  },
  "devDependencies": {
    "svelte":     "^5.0.0",
    "typescript": "^7.0.0"
  }
}
