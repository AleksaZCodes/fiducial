{
  "name": "@fiducial/realtime",
  "version": "0.1.0",
  "description": "Typed Broadcast and Presence over Cloudflare Durable Objects — WebSocket hibernation, zero Supabase dependency",
  "license": "MIT",
  "author": "Aleksa Zdravkovic",
  "repository": {
    "type": "git",
    "url": "https://github.com/AleksaZCodes/fiducial.git"
  },
  "homepage": "https://github.com/AleksaZCodes/fiducial",
  "keywords": [
    "realtime",
    "cloudflare",
    "durable-objects",
    "broadcast",
    "presence",
    "websocket",
    "fiducial"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./durable-object": {
      "import": "./dist/durable-object.js",
      "types": "./dist/durable-object.d.ts"
    },
    "./client": {
      "import": "./dist/durable-object-client.js",
      "types": "./dist/durable-object-client.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured yet'",
    "test": "node --test src/realtime.test.js"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
