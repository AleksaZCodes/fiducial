{
  "name": "@fiducial/realtime",
  "version": "0.2.0",
  "description": "Supabase Realtime typed wrappers \u2014 Broadcast, Presence, and Postgres Changes",
  "license": "MIT",
  "author": "Aleksa Zdravkovic",
  "repository": {
    "type": "git",
    "url": "https://github.com/AleksaZCodes/fiducial.git"
  },
  "homepage": "https://github.com/AleksaZCodes/fiducial",
  "keywords": [
    "realtime",
    "supabase",
    "broadcast",
    "presence",
    "postgres-changes",
    "fiducial"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./durable-object": {
      "import": "./dist/durable-object.js",
      "types": "./dist/durable-object.d.ts"
    },
    "./client": {
      "import": "./dist/durable-object-client.js",
      "types": "./dist/durable-object-client.d.ts"
    },
    "./relay": {
      "import": "./dist/relay.js",
      "types": "./dist/relay.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured yet'",
    "test": "node --test src/realtime.test.js"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/ws": "^8.5.13"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "bin": {
    "realtime-relay": "./dist/relay-bin.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
