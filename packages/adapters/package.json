{
  "name": "@fiducial/adapters",
  "version": "0.4.0",
  "description": "Cross-platform adapter contracts for Fiducial — database, storage, email, diagnostics, bot protection, queue, auth, AI.",
  "license": "MIT",
  "author": "Aleksa Zdravkovic",
  "repository": {
    "type": "git",
    "url": "https://github.com/AleksaZCodes/fiducial.git"
  },
  "homepage": "https://github.com/AleksaZCodes/fiducial",
  "keywords": ["adapters", "database", "storage", "email", "fiducial", "cross-platform"],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./database": {
      "import": "./dist/database.js",
      "types": "./dist/database.d.ts"
    },
    "./storage": {
      "import": "./dist/storage.js",
      "types": "./dist/storage.d.ts"
    },
    "./email": {
      "import": "./dist/email.js",
      "types": "./dist/email.d.ts"
    },
    "./diagnostics": {
      "import": "./dist/diagnostics.js",
      "types": "./dist/diagnostics.d.ts"
    },
    "./bot-protection": {
      "import": "./dist/bot-protection.js",
      "types": "./dist/bot-protection.d.ts"
    },
    "./migrate": {
      "import": "./dist/migrate.js",
      "types": "./dist/migrate.d.ts"
    },
    "./queue": {
      "import": "./dist/queue.js",
      "types": "./dist/queue.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    },
    "./newsletter": {
      "import": "./dist/newsletter.js",
      "types": "./dist/newsletter.d.ts"
    },
    "./ai": {
      "import": "./dist/ai.js",
      "types": "./dist/ai.d.ts"
    },
    "./system-one": {
      "import": "./dist/system-one.js",
      "types": "./dist/system-one.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/adapters.test.js src/migrate.test.js src/system-one.test.js",
    "test:generated": "node --test src/generated-factory.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
